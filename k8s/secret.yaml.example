# Kubernetes Secret Template
# DO NOT commit this file with real values!
# Copy to secret.yaml and fill in your values, then:
# kubectl apply -f k8s/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: hdhr-scanner-secrets
  labels:
    app: hdhr-scanner
    version: "3.0"
type: Opaque
stringData:
  # OpenAI API Key (optional)
  # Get from: https://platform.openai.com/api-keys
  OPENAI_API_KEY: "sk-your-openai-api-key-here"

  # HDHomeRun Device ID (optional, for automation)
  # Find with: hdhomerun_config discover
  HDHR_DEVICE_ID: ""

# Alternative: Create secret from command line
# kubectl create secret generic hdhr-scanner-secrets \
#   --from-literal=OPENAI_API_KEY='sk-your-key-here' \
#   --from-literal=HDHR_DEVICE_ID='12345678'

# Or from .env file:
# kubectl create secret generic hdhr-scanner-secrets --from-env-file=.env
