# HDHomeRun Channel Scanner - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================================================
# OpenAI Configuration (Optional)
# ============================================================================
# Used for AI-powered geographic location identification
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# Application Configuration
# ============================================================================
# Default HDHomeRun device ID (skip device selection)
# Find with: hdhomerun_config discover
HDHR_DEVICE_ID=

# Default tuner number (0-3)
HDHR_TUNER=0

# Output directory for scan results
# Leave empty to use current directory
OUTPUT_DIR=

# ============================================================================
# Docker Configuration
# ============================================================================
# Timezone for container
TZ=UTC

# Docker registry for pushing images
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=yourusername
DOCKER_IMAGE=hdhr-scanner
DOCKER_TAG=3.0

# ============================================================================
# Kubernetes Configuration
# ============================================================================
# Kubernetes namespace
K8S_NAMESPACE=default

# Number of replicas (for cron jobs, typically 1)
K8S_REPLICAS=1

# Resource limits
K8S_CPU_LIMIT=1000m
K8S_MEMORY_LIMIT=512Mi
K8S_CPU_REQUEST=500m
K8S_MEMORY_REQUEST=256Mi

# ============================================================================
# CI/CD Configuration
# ============================================================================
# GitHub Container Registry token (for CI/CD)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Docker Hub credentials (alternative to GHCR)
DOCKER_HUB_USERNAME=
DOCKER_HUB_TOKEN=

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode by default
DEBUG_MODE=false

# Enable quiet mode by default
QUIET_MODE=false

# ============================================================================
# Production Environment
# ============================================================================
# Environment name: development, staging, production
ENVIRONMENT=development

# Enable production safety features
PRODUCTION_MODE=false

# ============================================================================
# Automation Configuration
# ============================================================================
# Automatically save CSV without prompting
AUTO_SAVE_CSV=true

# Automatically query OpenAI without prompting
AUTO_OPENAI=false

# ============================================================================
# Network Configuration
# ============================================================================
# HDHomeRun discovery timeout (seconds)
DISCOVERY_TIMEOUT=10

# Scan timeout (seconds)
SCAN_TIMEOUT=300

# ============================================================================
# Usage Examples
# ============================================================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your values:
#    nano .env
#
# 3. Source the file (optional, for local use):
#    source .env
#
# 4. Docker Compose will automatically load .env
#    docker-compose up
#
# 5. For Kubernetes, create secret:
#    kubectl create secret generic hdhr-scanner-config --from-env-file=.env
